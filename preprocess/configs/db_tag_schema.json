  "tags": {
    "table_types": {                
      "items": [
        {
          "tag": "MASTER",
          "description": "主实体表 - 存储核心业务实体，通常是查询的起点",
          "examples": ["student", "customer", "product", "employee"],
          "characteristics": ["有唯一业务标识符", "常作为查询的FROM主体", "与其他表有一对多关系"]
        },
        {
          "tag": "TRANSACTION",
          "description": "事务表 - 记录业务事件或操作结果",
          "examples": ["grade", "order", "sale_record", "exam_result"],
          "characteristics": ["有外键关联到MASTER表", "包含时间戳", "记录量随时间增长"]
        },
        {
          "tag": "REFERENCE",
          "description": "参考表 - 存储固定的分类或代码数据",
          "examples": ["department", "category", "status_code", "country"],
          "characteristics": ["数据相对稳定", "记录数较少", "常被其他表作为外键引用"]
        },
        {
          "tag": "RELATION",
          "description": "关系表 - 专门处理多对多关系或关联明细",
          "examples": ["enrollment", "order_item", "user_role", "project_member"],
          "characteristics": ["通常只有外键和少量属性", "连接两个或多个MASTER表", "记录关联关系"]
        },
        {
          "tag": "LOG",
          "description": "日志表 - 记录系统操作或状态变更历史",
          "examples": ["audit_log", "price_history", "status_change_log"],
          "characteristics": ["主要包含时间戳和描述", "通常只追加不修改", "用于追踪和审计"]
        },
        {
          "tag": "DIMENSION",
          "description": "维度表 - 数据仓库中的描述性属性表",
          "examples": ["time_dimension", "customer_dim", "product_dim"],
          "characteristics": ["包含层次结构和属性", "用于分析和报表", "星型/雪花模型的一部分"]
        },
        {
          "tag": "EMPTY",
          "description": "找不到对应的TAG"
        }
      ]
    },
