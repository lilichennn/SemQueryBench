MCS_SQL_BASE_DIR=.
MCS_SQL_DATASET_TYPE=mid
MCS_SQL_DATASET_PATH=./dataset/mid
MCS_SQL_RUN_DIR=./baseline/MCS-SQL-main/run_mid-3

MCS_SQL_MYSQL_HOST=localhost
MCS_SQL_MYSQL_PORT=3306
MCS_SQL_MYSQL_USER=root
MCS_SQL_MYSQL_PASSWORD=

MCS_SQL_LLM_URL=
MCS_SQL_LLM_API_KEY=
MCS_SQL_LLM_MODEL=qwen-max
MCS_SQL_EMBEDDING_MODEL_PATH=BAAI/bge-large-en-v1.5

MCS_SQL_TABLE_LINKING_PROMPTS=1
MCS_SQL_COLUMN_LINKING_PROMPTS=1
MCS_SQL_SAMPLES_PER_PROMPT=1
MCS_SQL_GENERATION_PROMPTS=1
MCS_SQL_FEW_SHOT_EXAMPLES=5
MCS_SQL_CONFIDENCE_THRESHOLD=0.2
MCS_SQL_TIMEOUT=60
MCS_SQL_TEMPERATURE=1.0
MCS_SQL_CANDIDATES=5
MCS_SQL_DEBUG_MODE=off
MCS_SQL_TEST_START_INDEX=0
MCS_SQL_TEST_END_INDEX=1

MCS_SQL_PRED_FILE=./predictions.json
MCS_SQL_QUESTIONS_FILE=./dataset/easy/dev/dev.json
MCS_SQL_EVAL_OUTPUT=./evaluation_results.txt
